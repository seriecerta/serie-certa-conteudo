# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# --- Voz (ElevenLabs)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Publicação automática
# false = só simula (mostra o que publicaria). Mude para true depois do primeiro teste.
PUBLICACAO_AUTOMATICA=false
# Instagram não publica se o horário passou há mais que isso (ex.: computador dormiu)
MAX_ATRASO_HORAS=4
# Marca vídeos como conteúdo feito com IA (Instagram: is_ai_generated; YouTube: containsSyntheticMedia)
MARCAR_CONTEUDO_IA=true
# INSTAGRAM_API_VERSION=v25.0

# --- Hospedagem temporária da mídia para o Instagram (Supabase Storage do Série Certa)
SUPABASE_URL=https://idbwkhutuomakeptnyia.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=conteudo-redes
